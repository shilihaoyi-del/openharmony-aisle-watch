Panels:
  - Class: rviz/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Global Options:
    Fixed Frame: map
    Frame Rate: 15
    Background Color: 40; 40; 40
  Displays:
    - Class: rviz/Grid
      Name: Grid (1 metre)
      Enabled: true
      Cell Size: 1
      Plane: XY
    - Class: rviz/Map
      Name: SIMULATION - SLAM map
      Enabled: true
      Topic: /map
      Alpha: 0.9
      Color Scheme: map
    - Class: rviz/LaserScan
      Name: Simulated laser
      Enabled: true
      Topic: /scan
      Size (m): 0.03
      Style: Points
    - Class: rviz/Path
      Name: Global route
      Enabled: true
      Topic: /move_base/NavfnROS/plan
      Color: 0; 180; 80
      Line Style: Lines
      Line Width: 0.04
    - Class: rviz/Path
      Name: Local route
      Enabled: true
      Topic: /move_base/DWAPlannerROS/local_plan
      Color: 230; 120; 30
      Line Width: 0.04
    - Class: rviz/Pose
      Name: Simulated robot pose
      Enabled: true
      Topic: /sim/ground_truth
      Shape: Arrow
      Color: 50; 120; 240
  Tools:
    - Class: rviz/Interact
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/SetInitialPose
      Topic: /initialpose
    - Class: rviz/SetGoal
      Topic: /move_base_simple/goal
  Views:
    Current:
      Class: rviz/TopDownOrtho
      Name: Current View
      Scale: 85
      X: 3
      Y: 2
      Target Frame: map
Window Geometry:
  Width: 1100
  Height: 800
