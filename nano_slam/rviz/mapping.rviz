Panels:
  - Class: rviz/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Global Options:
    Fixed Frame: map
    Frame Rate: 15
    Background Color: 40; 40; 40
  Displays:
    - Class: rviz/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane: XY
    - Class: rviz/Map
      Name: Map
      Enabled: true
      Topic: /map
      Alpha: 0.8
      Color Scheme: map
    - Class: rviz/LaserScan
      Name: LaserScan
      Enabled: true
      Topic: /scan
      Size (m): 0.03
      Style: Points
  Views:
    Current:
      Class: rviz/TopDownOrtho
      Name: Current View
      Scale: 40
      Target Frame: map
Window Geometry:
  Width: 1100
  Height: 750
