<launch>
  <node pkg="nano_slam" type="sim_base.py" name="sim_base" output="screen"/>
  <node pkg="nano_slam" type="safety_gate.py" name="safety_gate" output="screen"/>
  <node pkg="gmapping" type="slam_gmapping" name="slam_gmapping" output="screen">
    <param name="base_frame" value="base_link"/>
    <param name="odom_frame" value="odom"/>
    <param name="map_frame" value="map"/>
    <param name="map_update_interval" value="1.0"/>
    <param name="maxUrange" value="7.5"/>
    <param name="maxRange" value="8.0"/>
    <param name="minimumScore" value="30.0"/>
    <param name="linearUpdate" value="0.15"/>
    <param name="angularUpdate" value="0.15"/>
    <param name="temporalUpdate" value="1.0"/>
    <param name="particles" value="15"/>
    <param name="delta" value="0.05"/>
    <param name="xmin" value="-1.0"/><param name="ymin" value="-1.0"/>
    <param name="xmax" value="9.0"/><param name="ymax" value="7.0"/>
  </node>
</launch>
